From 382da5dd5ec11ac29cc176799626ee656e47d312 Mon Sep 17 00:00:00 2001
From: Peter Bailey <peter.bailey@raspberrypi.com>
Date: Thu, 17 Sep 2026 17:14:24 +0100
Subject: [PATCH] net: macb: Fix clock leak in gem_get_tsu_rate

Release the tsu_clk in gem_get_tsu_rate after getting the rate.

Signed-off-by: Peter Bailey <peter.bailey@raspberrypi.com>
---
 drivers/net/ethernet/cadence/macb_main.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/cadence/macb_main.c
+++ b/drivers/net/ethernet/cadence/macb_main.c
@@ -3956,9 +3956,11 @@ static unsigned int gem_get_tsu_rate(str
 	struct clk *tsu_clk;
 	unsigned int tsu_rate;
 
-	tsu_clk = devm_clk_get(&bp->pdev->dev, "tsu_clk");
-	if (!IS_ERR(tsu_clk))
+	tsu_clk = clk_get(&bp->pdev->dev, "tsu_clk");
+	if (!IS_ERR(tsu_clk)) {
 		tsu_rate = clk_get_rate(tsu_clk);
+		clk_put(tsu_clk);
+	}
 	/* try pclk instead */
 	else if (!IS_ERR(bp->pclk)) {
 		tsu_clk = bp->pclk;

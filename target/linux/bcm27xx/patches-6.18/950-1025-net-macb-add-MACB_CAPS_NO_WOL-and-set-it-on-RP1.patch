From de7e55eaf8b3e217da91fa319050f978f5dc791e Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Fri, 11 Sep 2026 14:44:26 +0100
Subject: [PATCH] net: macb: add MACB_CAPS_NO_WOL and set it on RP1

On Raspberry Pi 5 the MAC interrupt is routed through the RP1 irqchip,
which implements neither .irq_set_wake nor IRQCHIP_SKIP_SET_WAKE, so it
cannot be armed as a system wakeup source. Wake-on-LAN cannot work; the
board wakes from the power button on the BCM2712 GPIO instead.

The driver advertises WoL unconditionally, and userspace acts on that:
LibreELEC enables it at runtime whenever CONFIG_SUSPEND is set. That
makes device_may_wakeup() true, which diverts macb_suspend() away from
the path that works - phylink_stop() and macb_reset_hw() are skipped,
the receiver is left enabled with the WOL register armed, and neither
pm_runtime_force_suspend() nor macb_clks_disable() runs - all for a
wakeup that will never fire. Images that leave WoL alone resume fine.

Add MACB_CAPS_NO_WOL for MACs that cannot wake the system and set it on
RP1. The device is then not marked wakeup-capable, WoL is not offered to
ethtool, and a request to enable it is rejected with -EOPNOTSUPP before
phylink is asked, so the PHY is not left armed either. Disabling WoL
still succeeds, and suspend keeps taking the path known to resume.

device_set_wakeup_capable() moves below macb_configure_caps(), as
bp->caps is not populated until then.

Signed-off-by: Dom Cobley <popcornmix@gmail.com>
---
 drivers/net/ethernet/cadence/macb.h      |  5 +++++
 drivers/net/ethernet/cadence/macb_main.c | 11 +++++++++--
 2 files changed, 14 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/cadence/macb.h
+++ b/drivers/net/ethernet/cadence/macb.h
@@ -797,6 +797,11 @@
  * read-back to guarantee delivery.  Currently set only on RP1.
  */
 #define MACB_CAPS_PCIE_POSTED_WRITES		0x00004000
+/* The MAC cannot act as a system wakeup source, because the interrupt it
+ * would raise cannot be armed as a wakeup by the parent irqchip.  Refuse
+ * WoL rather than arming hardware that will never wake anything.
+ */
+#define MACB_CAPS_NO_WOL			0x00008000
 #define MACB_CAPS_PCS				0x01000000
 #define MACB_CAPS_HIGH_SPEED			0x02000000
 #define MACB_CAPS_CLK_HW_CHG			0x04000000
--- a/drivers/net/ethernet/cadence/macb_main.c
+++ b/drivers/net/ethernet/cadence/macb_main.c
@@ -3854,7 +3854,8 @@ static void macb_get_wol(struct net_devi
 	struct macb *bp = netdev_priv(netdev);
 
 	phylink_ethtool_get_wol(bp->phylink, wol);
-	wol->supported |= (WAKE_MAGIC | WAKE_ARP);
+	if (device_can_wakeup(&bp->pdev->dev))
+		wol->supported |= (WAKE_MAGIC | WAKE_ARP);
 
 	/* Add macb wolopts to phy wolopts */
 	wol->wolopts |= bp->wolopts;
@@ -3865,6 +3866,9 @@ static int macb_set_wol(struct net_devic
 	struct macb *bp = netdev_priv(netdev);
 	int ret;
 
+	if (wol->wolopts && !device_can_wakeup(&bp->pdev->dev))
+		return -EOPNOTSUPP;
+
 	/* Pass the order to phylink layer */
 	ret = phylink_ethtool_set_wol(bp->phylink, wol);
 	/* Don't manage WoL on MAC, if PHY set_wol() fails */
@@ -5808,6 +5812,7 @@ static const struct macb_config raspberr
 		MACB_CAPS_JUMBO |
 		MACB_CAPS_GEM_HAS_PTP |
 		MACB_CAPS_PCIE_POSTED_WRITES |
+		MACB_CAPS_NO_WOL |
 		MACB_CAPS_EEE,
 	.dma_burst_length = 16,
 	.clk_init = macb_clk_init,
@@ -5945,7 +5950,6 @@ static int macb_probe(struct platform_de
 		bp->max_tx_length = GEM_MAX_TX_LEN;
 
 	bp->wol = 0;
-	device_set_wakeup_capable(&pdev->dev, 1);
 
 	bp->usrio = macb_config->usrio;
 
@@ -5980,6 +5984,9 @@ static int macb_probe(struct platform_de
 	/* setup capabilities */
 	macb_configure_caps(bp, macb_config);
 
+	if (!(bp->caps & MACB_CAPS_NO_WOL))
+		device_set_wakeup_capable(&pdev->dev, 1);
+
 #ifdef CONFIG_ARCH_DMA_ADDR_T_64BIT
 	if (GEM_BFEXT(DAW64, gem_readl(bp, DCFG6))) {
 		err = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(44));

From d0d85e4131ac9cb21633b6b991b462c71305d378 Mon Sep 17 00:00:00 2001
From: Peter Bailey <peter.bailey@raspberrypi.com>
Date: Thu, 1 Oct 2026 09:05:55 +0100
Subject: [PATCH] PM: suspend: Hide mem sleep when not supported

The bootloader has a device tree property to indicate suspend support.
If it is not 1 then suspend is not supported, so hide the deep option
in /sys/power/state and /sys/power/mem_sleep as well as s2idle.

Only do this on Raspberry Pi firmware, and always hide s2idle there:
nothing wakes the Pi from it by default (rtc-rpi has no interrupt; its
alarm is only acted on by the bootloader), so it never returns.

Signed-off-by: Peter Bailey <peter.bailey@raspberrypi.com>
---
 kernel/power/suspend.c | 37 ++++++++++++++++++++++++++++++++++---
 1 file changed, 34 insertions(+), 3 deletions(-)

--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -31,6 +31,7 @@
 #include <linux/compiler.h>
 #include <linux/moduleparam.h>
 #include <linux/fs.h>
+#include <linux/of.h>
 
 #include "power.h"
 
@@ -198,14 +199,44 @@ void __init pm_states_init(void)
 }
 
 /*
- * Without platform suspend (PSCI SYSTEM_SUSPEND) there are no wake sources
- * enabled by default, so suspend-to-idle never returns.
+ * Nothing wakes a Raspberry Pi from suspend-to-idle by default (the RTC alarm
+ * is only seen by the bootloader), so it never returns. Suspend-to-RAM needs
+ * PSCI SYSTEM_SUSPEND and a bootloader that supports it.
  */
 static int __init rpi_disable_s2idle(void)
 {
-	if (suspend_ops)
+	struct device_node *np;
+	u32 val;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "raspberrypi,bcm2835-firmware");
+	if (!np)
 		return 0;
+	of_node_put(np);
+
+	if (!suspend_ops)
+		goto disable_s2idle;
+
+	np = of_find_node_by_path("/chosen/bootloader");
+	if (!np)
+		goto disable_suspend;
+
+	ret = of_property_read_u32(np, "suspend-to-ram", &val);
+	of_node_put(np);
+	if (ret)
+		goto disable_suspend;
+
+	if (val != 1)
+		goto disable_suspend;
+
+	pm_states[PM_SUSPEND_TO_IDLE] = NULL;
+	mem_sleep_states[PM_SUSPEND_TO_IDLE] = NULL;
+	return 0;
+
+disable_suspend:
+	mem_sleep_states[PM_SUSPEND_MEM] = NULL;
 
+disable_s2idle:
 	pm_states[PM_SUSPEND_MEM] = NULL;
 	pm_states[PM_SUSPEND_TO_IDLE] = NULL;
 	mem_sleep_states[PM_SUSPEND_TO_IDLE] = NULL;

 				   link_freqs[imx708->link_freq_idx]);
 	if (ret)
 		dev_err(&client->dev, "PLL calculation failed: %d\n", ret);
@@ -1110,6 +1158,7 @@ static int imx708_pll_write(struct imx70
 

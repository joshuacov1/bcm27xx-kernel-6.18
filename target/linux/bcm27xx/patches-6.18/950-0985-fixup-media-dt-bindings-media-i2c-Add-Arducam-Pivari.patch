From e3cef5683034dc058fe0e3d99f6112b20d5d250b Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Fri, 20 Nov 2026 15:00:16 +0000
Subject: [PATCH] fixup! media: dt-bindings: media: i2c: Add Arducam Pivariety
 Series CMOS sensor binding

Drop the leading zero from the example unit address.

Signed-off-by: Dom Cobley <popcornmix@gmail.com>
---
 .../devicetree/bindings/media/i2c/arducam-pivariety.yaml        | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/Documentation/devicetree/bindings/media/i2c/arducam-pivariety.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/arducam-pivariety.yaml
@@ -90,7 +90,7 @@ examples:
         #address-cells = <1>;
         #size-cells = <0>;
 
-        arducam_pivariety: sensor@0c {
+        arducam_pivariety: sensor@c {
             compatible = "arducam,arducam-pivariety";
             reg = <0x0c>;
             clocks = <&arducam_pivariety_clk>;

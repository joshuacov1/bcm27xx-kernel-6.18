From f53a6185ba45ed0df0a31494a14fcbf3f5068942 Mon Sep 17 00:00:00 2001
From: Jai Luthra <jai.luthra@ideasonboard.com>
Date: Wed, 8 Jul 2026 20:00:17 +0530
Subject: [PATCH] media: i2c: imx708: switch to CCI (and lowercase hex) for
 register writes

Signed-off-by: Jai Luthra <jai.luthra@ideasonboard.com>
Signed-off-by: Naushir Patuck <naush@raspberrypi.com>
---
 drivers/media/i2c/Kconfig  |    2 +
 drivers/media/i2c/imx708.c | 1119 ++++++++++++++++--------------------
 2 files changed, 506 insertions(+), 615 deletions(-)

--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -343,6 +343,8 @@ config VIDEO_IMX708
 	select MEDIA_CONTROLLER
 	select VIDEO_V4L2_SUBDEV_API
 	select V4L2_FWNODE
+	select V4L2_CCI_I2C
+	select VIDEO_CCS_PLL
 	help
 	  This is a Video4Linux2 sensor driver for the Sony
 	  IMX708 camera.
--- a/drivers/media/i2c/imx708.c
+++ b/drivers/media/i2c/imx708.c
@@ -6,7 +6,6 @@
  * Based on Sony imx477 camera driver
  * Copyright (C) 2020 Raspberry Pi Ltd
  */
-#include <linux/unaligned.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
@@ -14,6 +13,7 @@

From 54271d2fb9e391e450edda940ec01cb5cb072043 Mon Sep 17 00:00:00 2001
From: Phil Elwell <phil@raspberrypi.com>
Date: Wed, 18 Nov 2026 11:01:51 +0000
Subject: [PATCH] misc: rp1-pio: Wait for interrupt handlers before freeing a
 client

The interrupt handler for user space clients dereferences the client
that owns the interrupt. When a client is closed, its interrupts are
only disabled synchronously if they are still enabled. If the client
has already disabled an interrupt, which is done with
disable_irq_nosync(), a handler that was running at the time can still
be running when the owner is cleared and the client is freed.

Always wait for the handler when releasing an interrupt. Do it without
holding the device spinlock, because disable_irq() and
synchronize_irq() can sleep.

While here, check the ownership of an interrupt under the lock when
enabling or disabling it.

Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
Signed-off-by: Phil Elwell <phil@raspberrypi.com>
---
 drivers/misc/rp1-pio.c | 49 +++++++++++++++++++++++++++---------------
 1 file changed, 32 insertions(+), 17 deletions(-)

--- a/drivers/misc/rp1-pio.c
+++ b/drivers/misc/rp1-pio.c
@@ -983,10 +983,12 @@ int rp1_pio_irq_set_enabled(struct rp1_p
 	if (irq_index >= pio->irq_count)
 		return -EINVAL;
 	irqi = &pio->irqs[irq_index];
-	if (irqi->owner != client)
-		return -EBUSY;
 
 	spin_lock(&pio->lock);
+	if (irqi->owner != client) {
+		spin_unlock(&pio->lock);
+		return -EBUSY;
+	}
 	if (args->enabled && !irqi->enabled) {
 		enable_irq(irqi->irq);
 		irqi->enabled = true;
@@ -2079,26 +2081,39 @@ void rp1_pio_close(struct rp1_pio_client
 
 	/* Free any allocated resources */
 
-	spin_lock(&pio->lock);
 	for (i = 0; i < pio->irq_count; i++) {
+		bool enabled;
+
 		irqi = &pio->irqs[i];
-		if (irqi->owner == client) {
-			/*
-			 * Disable directly rather than via irq_set_enabled():
-			 * that helper takes pio->lock itself, and it is
-			 * already held here.
-			 */
-			if (irqi->enabled) {
-				disable_irq(irqi->irq);
-				irqi->enabled = false;
-			}
 
-			irqi->owner = NULL;
-			irqi->handler = NULL;
-			irqi->context = NULL;
+		spin_lock(&pio->lock);
+		if (irqi->owner != client) {
+			spin_unlock(&pio->lock);
+			continue;
 		}
+		enabled = irqi->enabled;
+		irqi->enabled = false;
+		spin_unlock(&pio->lock);
+
+		/*
+		 * The handler uses the client, so make sure it isn't running
+		 * and can't run again before giving up the interrupt. If the
+		 * interrupt was disabled with disable_irq_nosync() then the
+		 * handler may still be running. Both of these can sleep, so
+		 * call them without the lock - nobody else can claim the
+		 * interrupt while it still has an owner.
+		 */
+		if (enabled)
+			disable_irq(irqi->irq);
+		else
+			synchronize_irq(irqi->irq);
+
+		spin_lock(&pio->lock);
+		irqi->owner = NULL;
+		irqi->handler = NULL;
+		irqi->context = NULL;
+		spin_unlock(&pio->lock);
 	}
-	spin_unlock(&pio->lock);
 
 	if (client->claimed_sms) {
 		struct rp1_pio_sm_set_enabled_args se_args = {

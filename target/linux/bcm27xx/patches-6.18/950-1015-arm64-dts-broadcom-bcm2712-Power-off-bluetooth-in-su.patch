From a5fff1013a65f2765b8dd8b96a74d6ce0bfbe97b Mon Sep 17 00:00:00 2001
From: Peter Bailey <peter.bailey@raspberrypi.com>
Date: Tue, 25 Aug 2026 10:04:54 +0100
Subject: [PATCH] arm64: dts: broadcom: bcm2712: Power off bluetooth in suspend

Add a device tree property so that bluetooth is handled correctly after
suspend.

It is powered off so the device is registered again on resume.

Signed-off-by: Peter Bailey <peter.bailey@raspberrypi.com>
---
 arch/arm64/boot/dts/broadcom/bcm2712-rpi-5-b.dts  | 1 +
 arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi | 1 +
 2 files changed, 2 insertions(+)

--- a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-5-b.dts
+++ b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-5-b.dts
@@ -375,6 +375,7 @@ dpi_16bit_gpio2:        &rp1_dpi_16bit_g
 		compatible = "brcm,bcm43438-bt";
 		max-speed = <3000000>;
 		shutdown-gpios = <&gio 29 GPIO_ACTIVE_HIGH>;
+		brcm,power-off-in-suspend;
 		local-bd-address = [ 00 00 00 00 00 00 ];
 	};
 };
--- a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
+++ b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
@@ -359,6 +359,7 @@ dpi_16bit_gpio2:        &rp1_dpi_16bit_g
 		compatible = "brcm,bcm43438-bt";
 		max-speed = <3000000>;
 		shutdown-gpios = <&gio 29 GPIO_ACTIVE_HIGH>;
+		brcm,power-off-in-suspend;
 		local-bd-address = [ 00 00 00 00 00 00 ];
 	};
 };

From 64af454604e50b71ae0e5d8c1a8af0cb183398e5 Mon Sep 17 00:00:00 2001
From: Phil Elwell <phil@raspberrypi.com>
Date: Wed, 18 Nov 2026 11:01:49 +0000
Subject: [PATCH] misc: rp1-pio: Serialise DMA configuration and transfers

Nothing stops a client from issuing ioctls on the same file from
several threads at once, and the DMA state has no protection against
that. In particular, reconfiguring a channel frees its buffers and
releases the DMA channel while a transfer in another thread may be
sleeping with pointers into them, or be part way through copying user
data. The transfer then reads from or writes to freed memory, the
cyclic paths can write beyond a new, smaller buffer using the old
period size, and two concurrent configurations free everything twice.

Add a mutex to each channel, and hold it for the duration of every
configuration and user transfer. Decide whether there is an old
configuration to free from the state of the channel, under the mutex,
rather than from the claim bits, and make sure dma->chan never holds an
error pointer. The transfer paths sleep interruptibly, so a
reconfiguration waits for a blocked transfer to finish or be
interrupted.

A channel can be configured with no bounce buffers, for the benefit of
kernel clients that supply their own DMA addresses. That is no use to
user space, so fail user transfers on such a channel instead of taking
the remainder of a division by zero.

Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
Signed-off-by: Phil Elwell <phil@raspberrypi.com>
---
 drivers/misc/rp1-pio.c | 114 ++++++++++++++++++++++++++++++-----------
 1 file changed, 83 insertions(+), 31 deletions(-)

--- a/drivers/misc/rp1-pio.c
+++ b/drivers/misc/rp1-pio.c
@@ -112,6 +112,12 @@ struct dma_buf_info {
 };
 
 struct dma_info {
+	/*
+	 * Serialises the configuration and use of the channel by user space,
+	 * so that the channel and its buffers can't be freed or replaced
+	 * during a transfer.
+	 */
+	struct mutex lock;
 	struct semaphore buf_sem;
 	wait_queue_head_t cyclic_wait;
 	struct dma_chan *chan;
@@ -1258,7 +1264,7 @@ static int rp1_pio_sm_config_xfer_intern
 	bool tx = dir == RP1_PIO_DIR_TO_SM;
 	bool prefer_light_dma = flags & BIT(0);
 	bool force_dma_type = flags & BIT(1);
-	bool reconfigure = false;
+	struct dma_chan *chan;
 	phys_addr_t fifo_addr;
 	uint32_t dma_mask;
 	char chan_name[5];
@@ -1296,31 +1302,39 @@ static int rp1_pio_sm_config_xfer_intern
 
 	dma_mask = 1 << (sm * 2 + dir);
 
+	/* Fail quickly, rather than wait for another client's transfer */
 	spin_lock(&pio->lock);
-	if (!(pio->claimed_dmas & dma_mask & ~client->claimed_dmas)) {
+	if (!(pio->claimed_dmas & dma_mask & ~client->claimed_dmas))
 		dma = &pio->dma_configs[sm][dir];
-		if (client->claimed_dmas & dma_mask)
-			reconfigure = true;
+	spin_unlock(&pio->lock);
+	if (!dma)
+		return -EBUSY;
+
+	/*
+	 * Wait for any transfer or configuration by this client to finish,
+	 * then claim the channel for real.
+	 */
+	if (mutex_lock_interruptible(&dma->lock))
+		return -ERESTARTSYS;
+
+	spin_lock(&pio->lock);
+	if (pio->claimed_dmas & dma_mask & ~client->claimed_dmas) {
+		ret = -EBUSY;
+	} else {
 		pio->claimed_dmas |= dma_mask;
 		client->claimed_dmas |= dma_mask;
 	}
 	spin_unlock(&pio->lock);
-	if (!dma)
-		return -EBUSY;
+	if (ret)
+		goto out_unlock;
 
 	/* dma_release_channel() sleeps, so free the old channel outside the lock. */
-	if (reconfigure)
+	if (dma->chan)
 		rp1_pio_sm_dma_free(dma);
 
 	/* Note: the semaphore is only used by non-cyclic DMA */
 	sema_init(&dma->buf_sem, 0);
 
-	if (!reconfigure) {
-		/* the waitqueue and spinlock are only used by cyclic DMA */
-		init_waitqueue_head(&dma->cyclic_wait);
-		spin_lock_init(&dma->cyclic_lock);
-	}
-
 	/* Allocate and configure a DMA channel */
 	/* Careful - each SM FIFO has its own DREQ value */
 	chan_name[0] = tx ? 't' : 'r';
@@ -1338,11 +1352,15 @@ static int rp1_pio_sm_config_xfer_intern
 	dma->cyclic_underflow = false;
 	dma->cyclic_tx_issued = false;
 	dma->tx = tx;
-	dma->chan = dma_request_chan(dev, chan_name);
-	if (IS_ERR(dma->chan)) {
-		ret = PTR_ERR(dma->chan);
+	dma->buf_size = 0;
+	dma->buf_count = 0;
+	/* dma->chan is only ever NULL or a valid channel */
+	chan = dma_request_chan(dev, chan_name);
+	if (IS_ERR(chan)) {
+		ret = PTR_ERR(chan);
 		goto err_unclaim;
 	}
+	dma->chan = chan;
 	dma_get_slave_caps(dma->chan, &dma_caps);
 	if (force_dma_type &&
 	    dma_caps.max_burst != (prefer_light_dma ? 4 : 8)) {
@@ -1455,7 +1473,7 @@ static int rp1_pio_sm_config_xfer_intern
 		if (!tx)
 			dma_async_issue_pending(dma->chan);
 	}
-	return 0;
+	goto out_unlock;
 
 err_dma_free:
 	rp1_pio_sm_dma_free(dma);
@@ -1466,6 +1484,9 @@ err_unclaim:
 	pio->claimed_dmas &= ~dma_mask;
 	spin_unlock(&pio->lock);
 
+out_unlock:
+	mutex_unlock(&dma->lock);
+
 	return ret;
 }
 
@@ -1805,8 +1826,10 @@ static int rp1_pio_sm_xfer_data32_user(s
 {
 	struct rp1_pio_sm_xfer_data32_args *args = param;
 	struct rp1_pio_device *pio = client->pio;
-	struct dma_info *dma = NULL;
+	struct dma_info *dma;
 	uint32_t dma_mask;
+	bool claimed;
+	int ret;
 
 	if (args->sm >= RP1_PIO_SMS_COUNT || args->dir >= RP1_PIO_DIR_COUNT ||
 	    !args->data_bytes ||
@@ -1814,19 +1837,32 @@ static int rp1_pio_sm_xfer_data32_user(s
 		return -EINVAL;
 
 	dma_mask = 1 << (args->sm * 2 + args->dir);
+	dma = &pio->dma_configs[args->sm][args->dir];
+
+	/*
+	 * Hold the lock for the whole transfer, even though it may block,
+	 * so that the channel can't be reconfigured underneath it.
+	 */
+	if (mutex_lock_interruptible(&dma->lock))
+		return -ERESTARTSYS;
+
 	spin_lock(&pio->lock);
-	if (client->claimed_dmas & dma_mask)
-		dma = &pio->dma_configs[args->sm][args->dir];
+	claimed = client->claimed_dmas & dma_mask;
 	spin_unlock(&pio->lock);
-	if (!dma)
-		return -EINVAL;
 
-	if (args->dir == RP1_PIO_DIR_TO_SM)
-		return dma->cyclic ? rp1_pio_sm_tx_user_cyclic(pio, dma, args) :
-				     rp1_pio_sm_tx_user(pio, dma, args);
+	/* A channel configured with no buffers is of no use to user space */
+	if (!claimed || !dma->chan || !dma->buf_count)
+		ret = -EINVAL;
+	else if (args->dir == RP1_PIO_DIR_TO_SM)
+		ret = dma->cyclic ? rp1_pio_sm_tx_user_cyclic(pio, dma, args) :
+				    rp1_pio_sm_tx_user(pio, dma, args);
 	else
-		return dma->cyclic ? rp1_pio_sm_rx_user_cyclic(pio, dma, args) :
-				     rp1_pio_sm_rx_user(pio, dma, args);
+		ret = dma->cyclic ? rp1_pio_sm_rx_user_cyclic(pio, dma, args) :
+				    rp1_pio_sm_rx_user(pio, dma, args);
+
+	mutex_unlock(&dma->lock);
+
+	return ret;
 }
 
 static int rp1_pio_sm_xfer_data_user(struct rp1_pio_client *client, void *param)
@@ -2084,10 +2120,14 @@ void rp1_pio_close(struct rp1_pio_client
 			struct dma_info *dma = &pio->dma_configs[i >> 1][i & 1];
 
 			claimed &= ~mask;
-			/* The SMs have been disabled, so this is safe */
-			if (!dma->tx)
-				rp1_pio_sm_dma_flush_rx(dma);
-			rp1_pio_sm_dma_free(dma);
+			mutex_lock(&dma->lock);
+			if (dma->chan) {
+				/* The SMs have been disabled, so this is safe */
+				if (!dma->tx)
+					rp1_pio_sm_dma_flush_rx(dma);
+				rp1_pio_sm_dma_free(dma);
+			}
+			mutex_unlock(&dma->lock);
 		}
 	}
 
@@ -2377,6 +2417,18 @@ static int rp1_pio_probe(struct platform
 	pio->fw = fw;
 	spin_lock_init(&pio->lock);
 	mutex_init(&pio->instr_mutex);
+	for (i = 0; i < RP1_PIO_SMS_COUNT; i++) {
+		int dir;
+
+		for (dir = 0; dir < RP1_PIO_DIR_COUNT; dir++) {
+			struct dma_info *dma = &pio->dma_configs[i][dir];
+
+			mutex_init(&dma->lock);
+			/* the waitqueue and spinlock are only used by cyclic DMA */
+			init_waitqueue_head(&dma->cyclic_wait);
+			spin_lock_init(&dma->cyclic_lock);
+		}
+	}
 
 	p = devm_platform_get_and_ioremap_resource(pdev, 0, &ioresource);
 	if (IS_ERR(p)) {
